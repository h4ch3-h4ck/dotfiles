#!/bin/sh
# Capturas: sustituye a `hyprshot -m output|region|window` (hyprshot depende de hyprctl).
# Guarda en ~/Pictures/Screenshots y copia al portapapeles.
# Requiere: grim, slurp, jq, wl-clipboard (y libnotify opcional)

mode=$1
dir="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
mkdir -p "$dir"
file="$dir/$(date +%Y-%m-%d_%H-%M-%S).png"

case "$mode" in
output)
    out=$(swaymsg -t get_outputs | jq -r '.[] | select(.focused) | .name')
    grim -o "$out" "$file"
    ;;
region)
    geom=$(slurp) || exit 0   # Esc en slurp = cancelar sin error
    grim -g "$geom" "$file"
    ;;
window)
    geom=$(swaymsg -t get_tree | jq -r '
      [ .. | objects | select(.focused? == true and .pid? != null) ] | .[0]
      | "\(.rect.x),\(.rect.y) \(.rect.width)x\(.rect.height)"')
    [ -n "$geom" ] && [ "$geom" != "null,null nullxnull" ] || exit 1
    grim -g "$geom" "$file"
    ;;
*)
    echo "uso: shot output|region|window" >&2
    exit 2
    ;;
esac

wl-copy < "$file"
command -v notify-send >/dev/null && notify-send "Captura guardada" "$file"
