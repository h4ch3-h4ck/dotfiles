# Reglas de ventana — equivalentes a hl.window_rule() de hyprland.lua.
# Sway distingue app_id (Wayland nativo) de class (XWayland); se cubren ambos
# donde una app puede salir por cualquiera de las dos vías.

for_window [app_id="^(pavucontrol|org\.pulseaudio\.pavucontrol|nm-connection-editor)$"] floating enable
for_window [class="^(pavucontrol|nm-connection-editor)$"] floating enable

for_window [app_id="^(xdg-desktop-portal-gtk|zenity)$"] floating enable

for_window [title="^(Abrir archivo|Guardar archivo|Select a file|Properties)$"] floating enable

for_window [app_id="^\.?blueman-manager(-wrapped)?$"] floating enable

for_window [title="^Picture-in-Picture$"] floating enable

for_window [app_id="^org\.gnome\.Calculator$"] floating enable, resize set width 600 px height 400 px, move position center
