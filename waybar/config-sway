// -*- mode: jsonc -*-
{
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    "height": 44, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 4, // Gaps between modules (4px)
    "modules-left": [
        "custom/arch",
        "sway/workspaces"
    ],
    "modules-center": [
        "sway/window"
    ],
    "modules-right": [
    	"tray",
    	"idle_inhibitor",
        "custom/target",  
        "custom/vpn",     
    	"pulseaudio",
    	"network",
    	"cpu",
    	"memory",
    	"temperature",
    	"sway/language",
    	"backlight",
    	"battery",
    	"clock"
    ],

    "include": [
		"~/.config/waybar/modules-sway.json"
	]
}
