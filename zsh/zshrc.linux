# Path to your oh-my-zsh installation.
export ZSH=$HOME/.oh-my-zsh

# Set name of the theme to load.
# Look in ~/.oh-my-zsh/themes/
# Optionally, if you set this to "random", it"ll load a random theme each
# time that oh-my-zsh is loaded.
ZSH_THEME=""

# Plugins
plugins=(git dotenv zsh-autosuggestions zsh-syntax-highlighting sudo z)

source $ZSH/oh-my-zsh.sh

export PATH=$HOME/.local/bin:$PATH

# Editor used by CLI
export EDITOR="nvim"
export SUDO_EDITOR="$EDITOR"
export ELECTRON_OZONE_PLATFORM_HINT="wayland"

# Git Logs
gitlog () {
  if (( ! $# )); then
    git log -15 --oneline --decorate --color --graph | cat
  else
    git log -$1 --oneline --decorate --color --graph | cat
  fi
}

# mise
if command -v mise &> /dev/null; then
  eval "$(mise activate zsh)"
fi

# starship prompt
if command -v starship &> /dev/null; then
 eval "$(starship init zsh)"
fi

# --- FZF CONFIGURATION (MODO PRO) ---
[ -f /usr/share/fzf/key-bindings.zsh ] && source /usr/share/fzf/key-bindings.zsh
[ -f /usr/share/fzf/completion.zsh ] && source /usr/share/fzf/completion.zsh

# Estética Neón y Layout Reversado
export FZF_DEFAULT_OPTS='--color=fg:#00ffff,hl:#ff00ff,fg+:#ffffff,bg+:-1,hl+:#ff00ff --info=inline --layout=reverse --border --height 45%'

# CTRL+T: Previsualiza el contenido del archivo con colores
export FZF_CTRL_T_OPTS="--preview 'bat --color=always --line-range :50 {}'"

# CTRL+R: Previsualiza el comando completo del historial
export FZF_CTRL_R_OPTS="--preview 'echo {}' --preview-window down:3:hidden:wrap --bind 'ctrl-/:toggle-preview'"

setwall() { pkill swaybg; swaybg -i "$1" -m fill & pkill waybar; waybar > /dev/null 2>&1 & }
