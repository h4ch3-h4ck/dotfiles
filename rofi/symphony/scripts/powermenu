#!/bin/bash
# Menú de apagado. Super+X en Sway.

pidof rofi >/dev/null && { pkill -x rofi; exit; }

lock="󰌾  Bloquear"
suspend="󰤄  Suspender"
logout="󰍃  Cerrar sesión"
reboot="󰜉  Reiniciar"
shutdown="󰐥  Apagar"

choice=$(printf '%s\n' "$lock" "$suspend" "$logout" "$reboot" "$shutdown" |
	rofi -dmenu -i -p "" -config "$HOME/.config/rofi/symphony/custom-rofi/config-powermenu.rasi")

case "$choice" in
"$lock") pidof hyprlock >/dev/null || hyprlock ;;
"$suspend") systemctl suspend ;;
"$logout") swaymsg exit ;;
"$reboot") systemctl reboot ;;
"$shutdown") systemctl poweroff ;;
esac
